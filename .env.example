# Copy to .env.local (Rayan's machine ONLY). Teammates never need keys. Restart `npm run dev` after every edit.
MODE=mock                      # mock | live   (webhook + "call me" only work when live)
PUBLIC_URL=                    # cloudflared https URL (changes every time cloudflared restarts!)
VAPI_API_KEY=                  # Vapi dashboard -> API Keys -> PRIVATE key
VAPI_PUBLIC_KEY=               # Vapi PUBLIC key (browser web-call fallback)
VAPI_PHONE_NUMBER_ID=          # the Twilio number imported into Vapi (Phone Numbers -> copy ID)
VAPI_WEBHOOK_SECRET=           # any long random string; Vapi sends it back on every webhook
VAPI_MODEL_PROVIDER=openai     # optional override
VAPI_MODEL=gpt-4o              # optional override
DEFAULT_LANG=hi                # hi | en | kn for inbound calls
DEMO_COMPANY_PHONE=            # teammate phone that plays "the bank" (+91..., verified in Twilio)
TEAM_PHONES=                   # comma list of team phones we may call (+91...,+91...). Nobody else is ever dialled.
# Not used by the app yet (kept for later):
VAPI_USER_ASSISTANT_ID=
VAPI_ADVOCATE_ASSISTANT_ID=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
